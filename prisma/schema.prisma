// CNC CRM v2 — data model (Build Spec §4)
// Conventions: UUID ids, timestamptz, money in paise (BigInt), dynamic lists are tables.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------
enum Role {
  admin
  group_admin
  cs
  employee
  client
}

enum ActiveStatus {
  active
  inactive
}

enum Gender {
  female
  male
  other
}

enum Tone {
  neutral
  crimson
  gold
  muted
}

enum FlagColour {
  gold
  crimson
  cream
  muted
}

enum Frequency {
  monthly_retainer
  quarterly
  yearly
  project_based
}

enum Priority {
  low
  normal
  high
  urgent
}

enum AttachmentKind {
  upload
  link
}

enum RaterKind {
  client
  cs
}

enum AttendanceState {
  present
  late
  absent
  leave
  holiday
  weekend
}

enum LeaveType {
  casual
  sick
  half_day
  wfh
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum ConcernCategory {
  workload
  client_behaviour
  process
  team
  leave
  equipment
  workplace
  pay
  other
}

enum ConcernStatus {
  open
  in_discussion
  resolved
}

enum FlagTargetRole {
  employee
  cs
}

enum ScoreParameter {
  on_time
  review_pass
  cs_rating
  eod
  attendance
  client_approval
  throughput
  rework
}

enum RequestStatus {
  new
  answered
  on_hold
  converted
}

enum AnnouncementType {
  announcement
  holiday
}

enum InvoiceStatus {
  draft
  sent
  viewed
  paid
  overdue
  void
}

enum PaymentMethod {
  upi
  card
  netbanking
  wallet
  offline
}

enum InvoiceEventKind {
  created
  sent
  viewed
  reminder
  paid
  voided
}

enum FilePurpose {
  brand_logo
  user_photo
  task
  project
  request
  comment
  concern
  announcement
  company_logo
  backdrop
}

enum NotificationModule {
  task
  approval
  request
  concern
  flag
  invoice
  announcement
  attendance
  sarthi
  system
}

enum ActorKind {
  user
  system
  agent
}

// ---------- 4.1 core ----------
model Company {
  id               String   @id @default(uuid()) @db.Uuid
  legalName        String   @map("legal_name")
  brandName        String   @map("brand_name")
  gstin            String?
  address          String?
  city             String?
  state            String?
  pincode          String?
  country          String   @default("India")
  timezone         String   @default("Asia/Kolkata")
  portalUrl        String?  @map("portal_url")
  logoFileId       String?  @map("logo_file_id") @db.Uuid
  studioHoursStart String   @default("09:30") @map("studio_hours_start")
  studioHoursEnd   String   @default("19:30") @map("studio_hours_end")
  lateLoginAfter   String   @default("10:30") @map("late_login_after")
  workingDays      Int[]    @default([1, 2, 3, 4, 5, 6]) @map("working_days")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("company")
}

model User {
  id              String       @id @default(uuid()) @db.Uuid
  firstName       String       @map("first_name")
  lastName        String       @default("") @map("last_name")
  email           String       @unique // stored lower-case
  loginId         String       @unique @map("login_id")
  passwordHash    String?      @map("password_hash")
  role            Role
  brandId         String?      @map("brand_id") @db.Uuid
  departmentId    String?      @map("department_id") @db.Uuid
  designation     String?
  photoFileId     String?      @map("photo_file_id") @db.Uuid
  gender          Gender?
  dob             DateTime?    @db.Date
  mobile          String?
  whatsappNo      String?      @map("whatsapp_no")
  personalEmail   String?      @map("personal_email")
  personalContact String?      @map("personal_contact")
  address         String?
  city            String?
  state           String?
  pincode         String?
  country         String?      @default("India")
  linkedin        String?
  facebook        String?
  instagram       String?
  status          ActiveStatus @default(active)
  preferences     Json         @default("{}") // theme, backdrop
  invitedAt       DateTime?    @map("invited_at") @db.Timestamptz
  lastLoginAt     DateTime?    @map("last_login_at") @db.Timestamptz
  legacyRowId     String?      @map("legacy_row_id")
  legacyId        Int?         @map("legacy_id")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy       String?      @map("created_by") @db.Uuid
  // Hierarchy (client request 2026-11-04): group admin → CS → employee.
  groupId         String?      @map("group_id") @db.Uuid
  reportsToId     String?      @map("reports_to_id") @db.Uuid

  group       TeamGroup?  @relation(fields: [groupId], references: [id], onDelete: Restrict)
  reportsTo   User?       @relation("ReportsTo", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     User[]      @relation("ReportsTo")
  brand       Brand?      @relation("BrandClients", fields: [brandId], references: [id], onDelete: Restrict)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  photo       File?       @relation("UserPhoto", fields: [photoFileId], references: [id])
  sessions    Session[]
  csBrands    BrandCs[]
  assignments TaskAssignee[]
  csTasks     Task[]      @relation("TaskCs")
  createdTasks Task[]     @relation("TaskCreator")
  notifications Notification[]
  flagsReceived Flag[]    @relation("FlagTarget")
  flagsGiven    Flag[]    @relation("FlagGiver")
  scores        PerformanceScore[]
  attendanceSessions AttendanceSession[]
  attendanceDays     AttendanceDay[]
  eodLogs            EodLog[]
  concerns           Concern[] @relation("ConcernRaiser")
  ownedConcerns      Concern[] @relation("ConcernOwner")
  concernReplies     ConcernReply[]
  leaveRequests      LeaveRequest[] @relation("LeaveRequester")
  taskComments       TaskComment[]
  projectComments    ProjectComment[]
  statusChanges      TaskStatusHistory[]
  ratings            TaskRating[]
  ownedRequests      WorkRequest[] @relation("RequestOwner")
  raisedRequests     WorkRequest[] @relation("RequestRaiser")
  requestReplies     WorkRequestReply[]
  announcements      Announcement[]
  invoicesCreated    Invoice[]
  resetTokens        PasswordReset[]

  @@index([role, status])
  @@index([groupId])
  @@index([reportsToId])
  @@map("user")
}

/// A team inside CNC, headed by one or more group admins (client request 2026-11-04).
model TeamGroup {
  id        String       @id @default(uuid()) @db.Uuid
  name      String       @unique
  status    ActiveStatus @default(active)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy String?      @map("created_by") @db.Uuid

  members User[]

  @@map("team_group")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  ip         String?
  userAgent  String?  @map("user_agent")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz
  impersonatorId String? @map("impersonator_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model PasswordReset {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset")
}

model Department {
  id     String       @id @default(uuid()) @db.Uuid
  name   String       @unique
  order  Int          @default(0)
  status ActiveStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  users     User[]
  assignees TaskAssignee[]

  @@map("department")
}

model ScopeOfWork {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @unique
  defaultRatePaise BigInt?      @map("default_rate_paise")
  status           ActiveStatus @default(active)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  brands   BrandScope[]
  projects ProjectScope[]

  @@map("scope_of_work")
}

model TaskTitle {
  id     String       @id @default(uuid()) @db.Uuid
  name   String       @unique
  status ActiveStatus @default(active)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tasks Task[]

  @@map("task_title")
}

model ServicingType {
  id               String       @id @default(uuid()) @db.Uuid
  name             String       @unique
  shortDescription String?      @map("short_description")
  description      String?
  status           ActiveStatus @default(active)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tasks Task[]

  @@map("servicing_type")
}

// Dynamic (§6.2). Semantic flags drive behaviour; names are free.
model TaskStatus {
  id           String       @id @default(uuid()) @db.Uuid
  name         String       @unique
  tone         Tone         @default(neutral)
  order        Int
  isStart      Boolean      @default(false) @map("is_start")
  isDone       Boolean      @default(false) @map("is_done")
  isClientGate Boolean      @default(false) @map("is_client_gate")
  isReview     Boolean      @default(false) @map("is_review")
  isRejected   Boolean      @default(false) @map("is_rejected")
  status       ActiveStatus @default(active)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  tasks       Task[]
  projects    Project[]
  historyFrom TaskStatusHistory[] @relation("HistFrom")
  historyTo   TaskStatusHistory[] @relation("HistTo")

  @@map("task_status")
}

model FlagType {
  id      String       @id @default(uuid()) @db.Uuid
  name    String       @unique
  colour  FlagColour
  points  Int
  note    String?
  status  ActiveStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  flags Flag[]

  @@map("flag_type")
}

// ---------- 4.2 brands & projects ----------
model Brand {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  companyName           String?      @map("company_name")
  division              String?
  logoFileId            String?      @map("logo_file_id") @db.Uuid
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  country               String?      @default("India")
  frequency             Frequency    @default(monthly_retainer)
  paymentTerms          String?      @map("payment_terms")
  officialEmail         String?      @map("official_email")
  whatsapp              String?
  website               String?
  twitter               String?
  linkedin              String?
  facebook              String?
  instagram             String?
  otherSocialLink       String?      @map("other_social_link")
  pocName               String?      @map("poc_name")
  pocPhone              String?      @map("poc_phone")
  vatNumber             String?      @map("vat_number")
  gstin                 String?
  additionalInformation String?      @map("additional_information")
  sinceYear             Int?         @map("since_year")
  feeNote               String?      @map("fee_note")
  preferences           Json         @default("{}") @map("brand_preferences")
  status                ActiveStatus @default(active)
  legacyRowId           String?      @map("legacy_row_id")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  createdBy             String?      @map("created_by") @db.Uuid

  logo         File?         @relation("BrandLogo", fields: [logoFileId], references: [id])
  clientUsers  User[]        @relation("BrandClients")
  cs           BrandCs[]
  scope        BrandScope[]
  projects     Project[]
  tasks        Task[]
  requests     WorkRequest[]
  invoices     Invoice[]
  flags        Flag[]

  @@index([status])
  @@map("brand")
}

model BrandCs {
  brandId   String  @map("brand_id") @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  isPrimary Boolean @default(false) @map("is_primary")

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([brandId, userId])
  @@map("brand_cs")
}

model BrandScope {
  brandId       String @map("brand_id") @db.Uuid
  scopeOfWorkId String @map("scope_of_work_id") @db.Uuid

  brand Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  scope ScopeOfWork @relation(fields: [scopeOfWorkId], references: [id], onDelete: Restrict)

  @@id([brandId, scopeOfWorkId])
  @@map("brand_scope")
}

model Project {
  id             String    @id @default(uuid()) @db.Uuid
  code           Int       @unique @default(autoincrement())
  brandId        String    @map("brand_id") @db.Uuid
  name           String
  brandPoc       String?   @map("brand_poc")
  pocPhone       String?   @map("poc_phone")
  type           String?
  subType        String?   @map("sub_type")
  description    String?
  startDate      DateTime? @map("start_date") @db.Date
  deadline       DateTime? @db.Date
  referenceLink1 String?   @map("reference_link_1")
  referenceLink2 String?   @map("reference_link_2")
  referenceLink3 String?   @map("reference_link_3")
  paymentTerms   String?   @map("payment_terms")
  priority       Priority  @default(normal)
  statusId       String    @map("status_id") @db.Uuid
  archivedAt     DateTime? @map("archived_at") @db.Timestamptz
  legacyRowId    String?   @map("legacy_row_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  createdBy      String?   @map("created_by") @db.Uuid

  brand    Brand            @relation(fields: [brandId], references: [id], onDelete: Restrict)
  status   TaskStatus       @relation(fields: [statusId], references: [id], onDelete: Restrict)
  scope    ProjectScope[]
  comments ProjectComment[]
  tasks    Task[]
  requests WorkRequest[]
  flags    Flag[]

  @@index([brandId])
  @@map("project")
}

model ProjectScope {
  projectId     String @map("project_id") @db.Uuid
  scopeOfWorkId String @map("scope_of_work_id") @db.Uuid

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scope   ScopeOfWork @relation(fields: [scopeOfWorkId], references: [id], onDelete: Restrict)

  @@id([projectId, scopeOfWorkId])
  @@map("project_scope")
}

model ProjectComment {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @map("project_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  body            String
  fileId          String?  @map("file_id") @db.Uuid
  visibleToClient Boolean  @default(false) @map("visible_to_client")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  file    File?   @relation(fields: [fileId], references: [id])

  @@map("project_comment")
}

// ---------- 4.3 tasks ----------
model Task {
  id              String    @id @default(uuid()) @db.Uuid
  code            Int       @unique @default(autoincrement())
  brandId         String    @map("brand_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  titleId         String    @map("title_id") @db.Uuid
  name            String
  description     String?
  servicingTypeId String?   @map("servicing_type_id") @db.Uuid
  priority        Priority  @default(normal)
  startDate       DateTime? @map("start_date") @db.Date
  deadlineAt      DateTime  @map("deadline_at") @db.Timestamptz
  deadlineWasText Boolean   @default(false) @map("deadline_was_text")
  statusId        String    @map("status_id") @db.Uuid
  csUserId        String    @map("cs_user_id") @db.Uuid
  createdById     String?   @map("created_by") @db.Uuid
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  submittedAt     DateTime? @map("submitted_at") @db.Timestamptz
  completedAt     DateTime? @map("completed_at") @db.Timestamptz
  shareWithClient Boolean   @default(true) @map("share_with_client")
  sarthiNudge     Boolean   @default(true) @map("sarthi_nudge")
  sourceRequestId String?   @map("source_request_id") @db.Uuid
  legacyRowId     String?   @map("legacy_row_id")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  brand       Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title       TaskTitle      @relation(fields: [titleId], references: [id], onDelete: Restrict)
  servicing   ServicingType? @relation(fields: [servicingTypeId], references: [id], onDelete: Restrict)
  status      TaskStatus     @relation(fields: [statusId], references: [id], onDelete: Restrict)
  cs          User           @relation("TaskCs", fields: [csUserId], references: [id], onDelete: Restrict)
  createdBy   User?          @relation("TaskCreator", fields: [createdById], references: [id])
  assignees   TaskAssignee[]
  attachments TaskAttachment[]
  history     TaskStatusHistory[]
  comments    TaskComment[]
  eodLogs     EodLog[]
  ratings     TaskRating[]
  flags       Flag[]
  convertedFrom WorkRequest[] @relation("ConvertedTask")

  @@index([brandId, statusId])
  @@index([deadlineAt])
  @@map("task")
}

model TaskAssignee {
  id           String    @id @default(uuid()) @db.Uuid
  taskId       String    @map("task_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  departmentId String?   @map("department_id") @db.Uuid
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  isLead       Boolean   @default(false) @map("is_lead")

  task       Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([taskId, userId])
  @@index([userId])
  @@map("task_assignee")
}

model TaskAttachment {
  id              String         @id @default(uuid()) @db.Uuid
  taskId          String         @map("task_id") @db.Uuid
  kind            AttachmentKind
  fileId          String?        @map("file_id") @db.Uuid
  url             String?
  label           String?
  uploadedBy      String?        @map("uploaded_by") @db.Uuid
  visibleToClient Boolean        @default(true) @map("visible_to_client")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  file File? @relation(fields: [fileId], references: [id])

  @@map("task_attachment")
}

model TaskStatusHistory {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  fromStatusId String?  @map("from_status_id") @db.Uuid
  toStatusId   String   @map("to_status_id") @db.Uuid
  byUserId     String?  @map("by_user_id") @db.Uuid
  note         String?
  at           DateTime @default(now()) @db.Timestamptz

  task Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  from TaskStatus? @relation("HistFrom", fields: [fromStatusId], references: [id])
  to   TaskStatus  @relation("HistTo", fields: [toStatusId], references: [id])
  by   User?       @relation(fields: [byUserId], references: [id])

  @@index([taskId, at])
  @@map("task_status_history")
}

model TaskComment {
  id              String   @id @default(uuid()) @db.Uuid
  taskId          String   @map("task_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  body            String
  kind            String   @default("comment") // comment | pause
  fileId          String?  @map("file_id") @db.Uuid
  visibleToClient Boolean  @default(false) @map("visible_to_client")
  mentions        String[] @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User  @relation(fields: [userId], references: [id], onDelete: Restrict)
  file File? @relation(fields: [fileId], references: [id])

  @@map("task_comment")
}

model EodLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  date         DateTime @db.Date // IST date
  remark       String
  statusAtTime String?  @map("status_at_time")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId, date])
  @@index([userId, date])
  @@map("eod_log")
}

model TaskRating {
  id            String    @id @default(uuid()) @db.Uuid
  taskId        String    @map("task_id") @db.Uuid
  ratedByUserId String    @map("rated_by_user_id") @db.Uuid
  raterKind     RaterKind @map("rater_kind")
  stars         Int
  review        String?
  at            DateTime  @default(now()) @db.Timestamptz

  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  ratedBy User @relation(fields: [ratedByUserId], references: [id])

  @@unique([taskId, raterKind])
  @@map("task_rating")
}

// ---------- 4.4 people ops ----------
model AttendanceSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  loginAt    DateTime  @map("login_at") @db.Timestamptz
  logoutAt   DateTime? @map("logout_at") @db.Timestamptz
  autoLogout Boolean   @default(false) @map("auto_logout")
  sessionId  String?   @map("session_id") @db.Uuid
  ip         String?
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, loginAt])
  @@map("attendance_session")
}

model AttendanceDay {
  id           String          @id @default(uuid()) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  date         DateTime        @db.Date
  firstLoginAt DateTime?       @map("first_login_at") @db.Timestamptz
  lastLogoutAt DateTime?       @map("last_logout_at") @db.Timestamptz
  hours        Decimal?        @db.Decimal(5, 2)
  autoLogout   Boolean         @default(false) @map("auto_logout")
  state        AttendanceState
  remark       String?
  remarkBy     String?         @map("remark_by") @db.Uuid
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, date])
  @@map("attendance_day")
}

model LeaveRequest {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  fromDate   DateTime    @map("from_date") @db.Date
  toDate     DateTime    @map("to_date") @db.Date
  type       LeaveType
  reason     String?
  status     LeaveStatus @default(pending)
  decidedBy  String?     @map("decided_by") @db.Uuid
  decidedAt  DateTime?   @map("decided_at") @db.Timestamptz
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz

  user User @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Restrict)

  @@map("leave_request")
}

model Concern {
  id               String          @id @default(uuid()) @db.Uuid
  code             Int             @unique @default(autoincrement())
  raisedByUserId   String          @map("raised_by_user_id") @db.Uuid
  category         ConcernCategory
  subject          String
  details          String
  fileId           String?         @map("file_id") @db.Uuid
  confidential     Boolean         @default(false)
  ownerUserId      String          @map("owner_user_id") @db.Uuid
  slaHours         Int             @default(24) @map("sla_hours")
  status           ConcernStatus   @default(open)
  resolvedAt       DateTime?       @map("resolved_at") @db.Timestamptz
  loggedOnBehalfBy String?         @map("logged_on_behalf_by") @db.Uuid
  legacyRowId      String?         @map("legacy_row_id")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  raisedBy User           @relation("ConcernRaiser", fields: [raisedByUserId], references: [id], onDelete: Restrict)
  owner    User           @relation("ConcernOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  file     File?          @relation(fields: [fileId], references: [id])
  replies  ConcernReply[]

  @@map("concern")
}

model ConcernReply {
  id        String   @id @default(uuid()) @db.Uuid
  concernId String   @map("concern_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  body      String
  at        DateTime @default(now()) @db.Timestamptz

  concern Concern @relation(fields: [concernId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("concern_reply")
}

model Flag {
  id             String         @id @default(uuid()) @db.Uuid
  flagTypeId     String         @map("flag_type_id") @db.Uuid
  targetUserId   String         @map("target_user_id") @db.Uuid
  targetRole     FlagTargetRole @map("target_role")
  givenByUserId  String         @map("given_by_user_id") @db.Uuid
  brandId        String?        @map("brand_id") @db.Uuid
  projectId      String?        @map("project_id") @db.Uuid
  taskId         String?        @map("task_id") @db.Uuid
  subject        String
  feedback       String
  pointsApplied  Int            @map("points_applied")
  month          DateTime       @db.Date
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz

  type    FlagType @relation(fields: [flagTypeId], references: [id], onDelete: Restrict)
  target  User     @relation("FlagTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  givenBy User     @relation("FlagGiver", fields: [givenByUserId], references: [id], onDelete: Restrict)
  brand   Brand?   @relation(fields: [brandId], references: [id])
  project Project? @relation(fields: [projectId], references: [id])
  task    Task?    @relation(fields: [taskId], references: [id])

  @@index([targetUserId, month])
  @@map("flag")
}

model PerformanceScore {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  month       DateTime @db.Date
  score       Int
  rankInDept  Int?     @map("rank_in_dept")
  breakdown   Json
  computedAt  DateTime @default(now()) @map("computed_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
  @@map("performance_score")
}

model ScoringWeight {
  parameter ScoreParameter @id
  weight    Int
  enabled   Boolean        @default(true)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@map("scoring_weight")
}

// ---------- 4.5 client-facing ----------
model WorkRequest {
  id              String        @id @default(uuid()) @db.Uuid
  code            Int           @unique @default(autoincrement())
  brandId         String        @map("brand_id") @db.Uuid
  projectId       String?       @map("project_id") @db.Uuid
  subject         String
  description     String?
  date            DateTime      @default(now()) @db.Timestamptz
  referenceLink   String?       @map("reference_link")
  neededBy        DateTime?     @map("needed_by") @db.Date
  pocName         String?       @map("poc_name")
  pocContact      String?       @map("poc_contact")
  priority        Priority      @default(normal)
  status          RequestStatus @default(new)
  ownerUserId     String?       @map("owner_user_id") @db.Uuid
  convertedTaskId String?       @map("converted_task_id") @db.Uuid
  raisedByUserId  String?       @map("raised_by_user_id") @db.Uuid
  channel         String        @default("portal") // portal | whatsapp | email | phone
  firstReplyAt    DateTime?     @map("first_reply_at") @db.Timestamptz
  legacyRowId     String?       @map("legacy_row_id")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  brand         Brand                   @relation(fields: [brandId], references: [id], onDelete: Restrict)
  project       Project?                @relation(fields: [projectId], references: [id])
  owner         User?                   @relation("RequestOwner", fields: [ownerUserId], references: [id])
  raisedBy      User?                   @relation("RequestRaiser", fields: [raisedByUserId], references: [id])
  convertedTask Task?                   @relation("ConvertedTask", fields: [convertedTaskId], references: [id])
  attachments   WorkRequestAttachment[]
  replies       WorkRequestReply[]

  @@index([brandId, status])
  @@map("work_request")
}

model WorkRequestAttachment {
  id            String         @id @default(uuid()) @db.Uuid
  workRequestId String         @map("work_request_id") @db.Uuid
  kind          AttachmentKind
  fileId        String?        @map("file_id") @db.Uuid
  url           String?
  label         String?

  request WorkRequest @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  file    File?       @relation(fields: [fileId], references: [id])

  @@map("work_request_attachment")
}

model WorkRequestReply {
  id              String   @id @default(uuid()) @db.Uuid
  workRequestId   String   @map("work_request_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  body            String
  at              DateTime @default(now()) @db.Timestamptz
  visibleToClient Boolean  @default(true) @map("visible_to_client")

  request WorkRequest @relation(fields: [workRequestId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("work_request_reply")
}

model Announcement {
  id            String           @id @default(uuid()) @db.Uuid
  code          Int              @unique @default(autoincrement())
  type          AnnouncementType
  subject       String
  date          DateTime         @db.Date
  message       String?
  showToClients Boolean          @default(false) @map("show_to_clients")
  broadcast     Boolean          @default(false)
  imageFileId   String?          @map("image_file_id") @db.Uuid
  postedById    String?          @map("posted_by") @db.Uuid
  archivedAt    DateTime?        @map("archived_at") @db.Timestamptz
  legacyRowId   String?          @map("legacy_row_id")
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  postedBy User? @relation(fields: [postedById], references: [id])
  image    File? @relation(fields: [imageFileId], references: [id])

  @@map("announcement")
}

model Invoice {
  id               String        @id @default(uuid()) @db.Uuid
  number           Int           @unique @default(autoincrement())
  brandId          String        @map("brand_id") @db.Uuid
  issueDate        DateTime?     @map("issue_date") @db.Date
  dueDate          DateTime?     @map("due_date") @db.Date
  subtotalPaise    BigInt        @map("subtotal_paise")
  gstRate          Decimal       @default(18) @map("gst_rate") @db.Decimal(5, 2)
  gstPaise         BigInt        @map("gst_paise")
  totalPaise       BigInt        @map("total_paise")
  notes            String?
  status           InvoiceStatus @default(draft)
  razorpayLinkId   String?       @map("razorpay_link_id")
  razorpayShortUrl String?       @map("razorpay_short_url")
  sentAt           DateTime?     @map("sent_at") @db.Timestamptz
  viewedAt         DateTime?     @map("viewed_at") @db.Timestamptz
  paidAt           DateTime?     @map("paid_at") @db.Timestamptz
  remindersEnabled Boolean       @default(true) @map("reminders_enabled")
  createdById      String?       @map("created_by") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  brand     Brand          @relation(fields: [brandId], references: [id], onDelete: Restrict)
  createdBy User?          @relation(fields: [createdById], references: [id])
  items     InvoiceItem[]
  payments  Payment[]
  events    InvoiceEvent[]

  @@index([brandId, status])
  @@map("invoice")
}

model InvoiceItem {
  id          String  @id @default(uuid()) @db.Uuid
  invoiceId   String  @map("invoice_id") @db.Uuid
  description String
  qty         Decimal @default(1) @db.Decimal(10, 2)
  unitPaise   BigInt  @map("unit_paise")
  amountPaise BigInt  @map("amount_paise")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_item")
}

model Payment {
  id                  String        @id @default(uuid()) @db.Uuid
  invoiceId           String        @map("invoice_id") @db.Uuid
  amountPaise         BigInt        @map("amount_paise")
  method              PaymentMethod
  razorpayPaymentId   String?       @unique @map("razorpay_payment_id")
  razorpaySignatureOk Boolean       @default(false) @map("razorpay_signature_ok")
  reference           String?
  receivedAt          DateTime      @default(now()) @map("received_at") @db.Timestamptz
  recordedBy          String?       @map("recorded_by") @db.Uuid

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@map("payment")
}

model InvoiceEvent {
  id        String           @id @default(uuid()) @db.Uuid
  invoiceId String           @map("invoice_id") @db.Uuid
  kind      InvoiceEventKind
  byUserId  String?          @map("by_user_id") @db.Uuid
  meta      Json             @default("{}")
  at        DateTime         @default(now()) @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_event")
}

// ---------- 4.6 platform ----------
model File {
  id           String      @id @default(uuid()) @db.Uuid
  storageKey   String      @unique @map("storage_key")
  originalName String      @map("original_name")
  mime         String
  bytes        Int
  width        Int?
  height       Int?
  thumb320Key  String?     @map("thumb_320_key")
  thumb1280Key String?     @map("thumb_1280_key")
  uploadedBy   String?     @map("uploaded_by") @db.Uuid
  purpose      FilePurpose
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz

  brandLogos      Brand[]                 @relation("BrandLogo")
  userPhotos      User[]                  @relation("UserPhoto")
  taskAttachments TaskAttachment[]
  taskComments    TaskComment[]
  projectComments ProjectComment[]
  requestFiles    WorkRequestAttachment[]
  concerns        Concern[]
  announcements   Announcement[]

  @@map("file")
}

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  module    NotificationModule
  event     String
  title     String
  body      String?
  link      String?
  readAt    DateTime?          @map("read_at") @db.Timestamptz
  emittedAt DateTime           @default(now()) @map("emitted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notification")
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorKind   ActorKind @map("actor_kind")
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  before      Json?
  after       Json?
  ip          String?
  at          DateTime  @default(now()) @db.Timestamptz

  @@index([entityType, entityId, at])
  @@map("audit_log")
}

model EventOutbox {
  id          String    @id @default(uuid()) @db.Uuid
  event       String
  payload     Json
  notify      Json      @default("[]") // in-app receivers, fanned out by the worker
  fannedOutAt DateTime? @map("fanned_out_at") @db.Timestamptz
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([deliveredAt])
  @@index([fannedOutAt])
  @@map("event_outbox")
}

model AgentAccess {
  id             String   @id @default(uuid()) @db.Uuid
  agentName      String   @unique @map("agent_name")
  dbRole         String   @map("db_role")
  allowedQueries Json     @map("allowed_queries")
  webhookUrl     String?  @map("webhook_url")
  webhookSecret  String?  @map("webhook_secret")
  enabled        Boolean  @default(true)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("agent_access")
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("setting")
}
